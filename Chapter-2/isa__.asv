function T = isa_temperature(h)

    layerBases = [0, 11000, 20000, 32000, 47000, 51000, 71000, 84852];
    lapseRates = [-0.0065, 0, 0.001, 0.0028, 0, -0.0028, -0.002];

    T0 = 288.15;

    T = zeros(size(h))

    for i = 1:length(lapseRates)
        idx = h >= layerBases(i) & h < layerBases(i+1);
        delta = h(idx) - layerBases(i);
        T(idx) = T0 + lapseRates(i) .*delta;
        T0 = T0 + lap

end